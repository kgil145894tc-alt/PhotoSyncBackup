{
  "expo": {
    "name": "PhotoSync",
    "slug": "PhotoSync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/photosync-app-icon.png",
    "scheme": "photosync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/photosync-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EEEE",
        "foregroundImage": "./assets/images/photosync-adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/photosync-adaptive-icon-background.png",
        "monochromeImage": "./assets/images/photosync-adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.kirl123.PhotoSync"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/photosync-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1D3E69",
          "defaultChannel": "photosync-bookings"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PhotoSync to choose service and package images from your gallery."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EEEE",
          "image": "./assets/images/photosync-logo.png",
          "imageWidth": 132
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5215d237-41b0-4947-a79f-e537bb73f7a2"
      }
    }
  }
}
